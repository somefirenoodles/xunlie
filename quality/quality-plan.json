{
  "schemaVersion": "xunlie.quality.plan/v1",
  "planId": "XUNLIE-SQP-001",
  "planVersion": "0.1.0",
  "status": "proposed",
  "nonCompensatory": true,
  "perfectScore": {
    "score": 100,
    "requiresAllMandatoryPass": true,
    "requiresAllEvidenceValid": true,
    "requiresFullTraceability": true,
    "allowsExpiredWaivers": false
  },
  "thresholds": {
    "requirementTraceabilityPercent": 100,
    "mandatoryEvidencePercent": 100,
    "lineCoveragePercent": 90,
    "branchCoveragePercent": 85,
    "criticalMutationScorePercent": 95,
    "globalMutationScorePercent": 85,
    "releaseCriticalVulnerabilities": 0,
    "releaseHighVulnerabilities": 0,
    "confirmedSecrets": 0,
    "requiredFlakyTests": 0,
    "openSev1Defects": 0,
    "openSev2Defects": 0,
    "maxWaiverDays": 30,
    "maxFlakyQuarantineDays": 14
  },
  "controls": [
    {"id": "CTRL-GOV-001", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Normative documents and machine contracts validate and agree.", "evidenceType": "validation-report"},
    {"id": "CTRL-GOV-002", "class": "MANDATORY", "ownerRole": "Product Owner", "description": "Roles are assigned to named accountable people and independence is feasible.", "evidenceType": "signed-role-register"},
    {"id": "CTRL-REQ-001", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Every applicable requirement maps to architecture, tests and gates.", "evidenceType": "traceability-report"},
    {"id": "CTRL-REQ-002", "class": "MANDATORY", "ownerRole": "Product Owner", "description": "Requirements are atomic and have observable acceptance criteria.", "evidenceType": "requirements-review"},
    {"id": "CTRL-RISK-001", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Product, security and delivery risks have owners, controls and residual decisions.", "evidenceType": "risk-register"},
    {"id": "CTRL-ARCH-001", "class": "MANDATORY", "ownerRole": "Chief Architect", "description": "Component dependency rules and responsibilities are complete and acyclic.", "evidenceType": "architecture-fitness-report"},
    {"id": "CTRL-ARCH-002", "class": "MANDATORY", "ownerRole": "Chief Architect", "description": "All applicable architecture invariants pass.", "evidenceType": "invariant-report"},
    {"id": "CTRL-CODE-001", "class": "MANDATORY", "ownerRole": "Developer/Maintainer", "description": "Formatting and static lint pass with warnings denied.", "evidenceType": "ci-check"},
    {"id": "CTRL-TEST-001", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Required unit, property, contract, integration and acceptance tests pass.", "evidenceType": "test-report"},
    {"id": "CTRL-TEST-002", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Coverage thresholds and differential coverage policy pass.", "evidenceType": "coverage-report"},
    {"id": "CTRL-TEST-003", "class": "RISK_BASED", "ownerRole": "Quality Lead", "description": "Mutation and fuzz campaigns meet thresholds for affected critical logic.", "evidenceType": "robustness-report"},
    {"id": "CTRL-TEST-004", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Verification strategy covers acceptance, properties, failure modes and platforms.", "evidenceType": "test-strategy-review"},
    {"id": "CTRL-SEC-001", "class": "MANDATORY", "ownerRole": "Security Lead", "description": "No disallowed vulnerability, SAST or secret finding is open.", "evidenceType": "security-scan-bundle"},
    {"id": "CTRL-SEC-002", "class": "MANDATORY", "ownerRole": "Security Lead", "description": "Workflows and permissions use minimum privilege and pinned actions.", "evidenceType": "workflow-security-report"},
    {"id": "CTRL-SEC-003", "class": "MANDATORY", "ownerRole": "Security Lead", "description": "Isolation and adversarial security tests pass.", "evidenceType": "security-test-report"},
    {"id": "CTRL-SEC-004", "class": "MANDATORY", "ownerRole": "Security Lead", "description": "Threat model is current for all affected trust boundaries.", "evidenceType": "threat-model-review"},
    {"id": "CTRL-SC-001", "class": "MANDATORY", "ownerRole": "Security Lead", "description": "Dependencies have approved sources, advisories and licenses.", "evidenceType": "dependency-policy-report"},
    {"id": "CTRL-SC-002", "class": "MANDATORY", "ownerRole": "Release Manager", "description": "Release SBOM, checksums and provenance are complete and independently verified.", "evidenceType": "release-attestation-bundle"},
    {"id": "CTRL-COMP-001", "class": "MANDATORY", "ownerRole": "Chief Architect", "description": "Schemas, protocols and supported CLI contracts meet compatibility policy.", "evidenceType": "compatibility-report"},
    {"id": "CTRL-EVID-001", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Evidence is complete, append-only, digest-linked and reproducible.", "evidenceType": "evidence-integrity-report"},
    {"id": "CTRL-REL-001", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "Replay and reproducibility checks pass for the required matrix.", "evidenceType": "replay-report"},
    {"id": "CTRL-REL-002", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "No required test is flaky or improperly quarantined.", "evidenceType": "flakiness-report"},
    {"id": "CTRL-PERF-001", "class": "RISK_BASED", "ownerRole": "Product Owner", "description": "Performance and resource budgets meet the approved baseline.", "evidenceType": "benchmark-report"},
    {"id": "CTRL-DOC-001", "class": "MANDATORY", "ownerRole": "Product Owner", "description": "User, operator, schema and change documentation match the candidate.", "evidenceType": "documentation-review"},
    {"id": "CTRL-REPO-001", "class": "MANDATORY", "ownerRole": "Quality Lead", "description": "GitHub rulesets, CODEOWNERS, required checks and break-glass policy are active and tested.", "evidenceType": "repository-controls-export"},
    {"id": "CTRL-DEC-001", "class": "MANDATORY", "ownerRole": "Product Owner", "description": "No decision marked blocking remains open for the stage.", "evidenceType": "decision-register-review"},
    {"id": "CTRL-OPS-001", "class": "MANDATORY", "ownerRole": "Release Manager", "description": "Monitoring, recovery, rollback, support and incident controls are effective.", "evidenceType": "operational-readiness-report"},
    {"id": "CTRL-RET-001", "class": "MANDATORY", "ownerRole": "Product Owner", "description": "Retirement preserves migration, required evidence and verified data disposition.", "evidenceType": "retirement-audit"}
  ]
}

